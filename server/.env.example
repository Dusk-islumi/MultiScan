# ============================================================================
# 复制为 .env 后按需修改：cp .env.example .env && chmod 600 .env
# .env 已被 .gitignore 排除，不会提交到仓库
# ============================================================================

# 数据库与凭据文件位置（默认在 server/data/ 下）
# DB_PATH=/path/to/server/data/scan.db
# CREDENTIALS_PATH=/path/to/server/data/credentials.txt

# 统一授权码：客户端所有请求都用它（Authorization: Bearer <此值>）
# 留空则 run.sh 自动生成到 data/enroll_secret.txt；
# 生产环境建议显式设置，生成方式：
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ENROLL_SECRET=

# 管理员控制台口令：留空则启动时自动生成到 data/admin_token.txt（推荐）
# 查看：cat data/admin_token.txt
# ADMIN_TOKEN=

# 是否开放 /docs、/openapi.json（生产保持 0）
ENABLE_DOCS=0

# 可信反向代理网段：只有直连对端在此范围内才采信 X-Forwarded-For
# 默认只信任回环（Nginx 与 uvicorn 同机部署时保持默认即可）
# TRUSTED_PROXIES=127.0.0.1,::1
