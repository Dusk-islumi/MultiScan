# Android / Gradle build outputs
.gradle/
build/
*/build/
local.properties
*.apk
*.aab
*.ap_
*.dex
captures/
.kotlin/

# Signing material (never commit)
*.keystore
*.jks
keystore.properties

# Android Studio / IntelliJ
.idea/
*.iml
.DS_Store
.externalNativeBuild/
.cxx/

# Python / server
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
pip-build-env-*/
pip-build-tracker-*/
pip-ephem-wheel-cache-*/
pip-install-*/
pip-metadata-*/
pip-modern-metadata-*/
pip-unpack-*/
server/build/
server/dist/
server/data/
*.db
*.db-wal
*.db-shm
.env

# Logs
*.log

# Release binaries under releases/ are intentionally tracked
!releases/*.apk
!releases/**/*.apk
!releases/*.zip

# Local adb / platform-tools bundle that used to sit next to the project.
# It has been moved to a private folder outside this repo; keep the rules so it
# can never be committed again.
/platform-tools/
/*.exe
/*.dll
/NOTICE.txt
/package.xml
/source.properties
/mke2fs.conf
